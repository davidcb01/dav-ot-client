            "data": "local FLASK_ID = 31296\nlocal CAULDRON_X = 33399\nlocal CAULDRON_Y = 32663\nlocal CAULDRON_Z = 5\n\n-- Pausa o CaveBot para firmar o char no piso\nCaveBot.pause(1000)\n\n-- Usa o frasco diretamente na coordenada do caldeirão\nlocal sucesso = Game.useItemOnGround(FLASK_ID, CAULDRON_X, CAULDRON_Y, CAULDRON_Z)\n\nif sucesso then\n    print(\"[CaveBot] Frasco de veneno usado com sucesso no caldeirao!\")\nelse\n    print(\"[CaveBot] Falha ao usar o frasco. Verifique se a BP com ele esta aberta.\")\nend",
