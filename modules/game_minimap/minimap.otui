UIMiniWindow
  id: mainmappanel
  draggable: true
  phantom: false
  focusable: false
  &save: true
  height: 134
  width: 176
  padding: 0
  image-source: /images/ui/miniwindow_body
  image-border: 4

  UIWidget
    id: miniwindowHeader
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 2
    margin-right: 2
    height: 15
    image-source: /images/ui/miniwindow_header
    image-border: 1
    border-width: 1
    border-color-top: #737373
    border-color-left: #737373
    border-color-right: #383838
    border-color-bottom: #383838
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.fill: miniwindowHeader
    phantom: true

  Label
    id: miniwindowTitle
    anchors.centerIn: miniwindowHeader
    font: verdana-11px-antialised
    color: #dfdfdf
    !text: tr('Map View')
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    visible: false
    size: 0 0
    anchors.top: parent.top
    anchors.right: parent.right

  UIButton
    id: minimizeButton
    visible: false
    size: 0 0
    anchors.top: parent.top
    anchors.right: parent.right

  UIMiniWindowContainer
    id: contentsPanel
    visible: false
    size: 0 0
    anchors.top: parent.top
    anchors.left: parent.left

  VerticalScrollBar
    id: miniwindowScrollBar
    visible: false
    size: 0 0
    anchors.top: parent.top
    anchors.right: parent.right

  UIWidget
    id: minimapBorder
    anchors.top: miniwindowHeader.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-left: 3
    margin-right: 3
    margin-bottom: 3
    image-source: /images/ui/1pixel_down_frame

    Minimap
      id: minimap
      anchors.fill: parent
      margin: 1

  UIWidget
    id: layersPanel
    size: 20 68
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 5
    margin-bottom: 5
    visible: false

    UIWidget
      id: automapLayers
      image-source: /images/automap/automap_indicator_maplayers
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      image-clip: 98 0 14 67
      size: 14 67

    UIWidget
      image-source: /images/ui/vertical_line_dark
      margin-left: 2
      margin-top: 4
      margin-bottom: 4
      anchors.left: automapLayers.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 1

    UIWidget
      id: layersMark
      anchors.left: prev.right
      anchors.top: automapLayers.top
      image-source: /images/automap/automap_indicator_slider_left
      margin-top: 28

    Button
      image-source: /images/automap/automap_phantom
      anchors.left: automapLayers.left
      anchors.right: automapLayers.right
      anchors.top: automapLayers.top
      anchors.bottom: automapLayers.verticalCenter
      @onClick: upLayer()

    Button
      image-source: /images/automap/automap_phantom
      anchors.left: automapLayers.left
      anchors.right: automapLayers.right
      anchors.top: automapLayers.verticalCenter
      anchors.bottom: automapLayers.bottom
      @onClick: downLayer()

  Button
    id: floorDown
    image-source: /images/automap/automap_floor_buttons
    image-clip: 0 20 20 20
    anchors.left: minimapBorder.left
    anchors.bottom: minimapBorder.bottom
    margin-left: 2
    margin-bottom: 2
    size: 20 20
    @onClick: downLayer()

    $hover !disabled:
      image-clip: 0 20 20 20

    $pressed !disabled:
      image-clip: 20 20 20 20

  Button
    id: floorUp
    image-source: /images/automap/automap_floor_buttons
    image-clip: 0 0 20 20
    anchors.left: floorDown.left
    anchors.bottom: floorDown.top
    margin-bottom: 1
    size: 20 20
    @onClick: upLayer()

    $hover !disabled:
      image-clip: 0 0 20 20

    $pressed !disabled:
      image-clip: 20 0 20 20

  Button
    id: fullMap
    image-source: /images/automap/automap_buttons
    image-clip: 0 0 20 20
    anchors.left: floorUp.left
    anchors.bottom: floorUp.top
    margin-bottom: 1
    size: 20 20
    @onClick: openCyclopediaMap()

    $hover !disabled:
      image-clip: 0 0 20 20

    $pressed !disabled:
      image-clip: 20 0 20 20

  Button
    id: zoomIn
    image-source: /images/automap/automap_buttons
    image-clip: 0 40 20 20
    anchors.right: minimapBorder.right
    anchors.bottom: minimapBorder.bottom
    margin-right: 2
    margin-bottom: 2
    size: 20 20
    @onClick: zoomIn()

    $hover !disabled:
      image-clip: 0 40 20 20

    $pressed !disabled:
      image-clip: 20 40 20 20

  Button
    id: zoomOut
    image-source: /images/automap/automap_buttons
    image-clip: 0 20 20 20
    anchors.right: zoomIn.right
    anchors.bottom: zoomIn.top
    margin-bottom: 1
    size: 20 20
    @onClick: zoomOut()

    $hover !disabled:
      image-clip: 0 20 20 20

    $pressed !disabled:
      image-clip: 20 20 20 20

  UIWidget
    id: rosePanel
    anchors.top: minimapBorder.top
    anchors.right: minimapBorder.right
    margin-top: 2
    margin-right: 2
    size: 43 43

    UIWidget
      id: ambients
      anchors.centerIn: parent
      size: 31 31

      UIWidget
        id: main
        image-source: /images/automap/timedisplay_scroll
        anchors.left: parent.left
        anchors.top: parent.top
        image-clip: 100 0 24 31
        size: 24 31

      UIWidget
        id: secondary
        image-source: /images/automap/timedisplay_scroll
        anchors.left: main.right
        anchors.top: parent.top
        image-clip: 0 0 7 31
        size: 7 31

      Button
        image-source: /images/automap/automap_phantom
        anchors.fill: parent
        @onClick: resetMap()

    UIWidget
      id: rose
      anchors.fill: parent
      image-source: /images/automap/automap_rose
      image-clip: 0 0 43 43
      phantom: true

    Button
      image-source: /images/automap/automap_rose
      image-clip: 14 0 15 8
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 14
      size: 15 8
      @onClick: |
        onClickRoseButton('north')

      $hover !disabled:
        image-clip: 14 0 15 8

      $pressed !disabled:
        image-clip: 57 0 15 8

    Button
      image-source: /images/automap/automap_rose
      image-clip: 28 0 15 15
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 28
      size: 15 15
      @onClick: |
        onClickRoseButton('north-east')

      $hover !disabled:
        image-clip: 28 0 15 15

      $pressed !disabled:
        image-clip: 114 0 15 15

    Button
      image-source: /images/automap/automap_rose
      image-clip: 35 14 8 15
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 35
      margin-top: 14
      size: 8 15
      @onClick: |
        onClickRoseButton('east')

      $hover !disabled:
        image-clip: 35 14 8 15

      $pressed !disabled:
        image-clip: 164 14 8 15  

    Button
      image-source: /images/automap/automap_rose
      image-clip: 28 28 15 15
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 28
      margin-top: 28
      size: 15 15
      @onClick: |
        onClickRoseButton('south-east')

      $hover !disabled:
        image-clip: 28 28 15 15

      $pressed !disabled:
        image-clip: 200 28 15 15

    Button
      image-source: /images/automap/automap_rose
      image-clip: 14 35 15 8
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 14
      margin-top: 35
      size: 15 8
      @onClick: |
        onClickRoseButton('south')

      $hover !disabled:
        image-clip: 14 35 15 8

      $pressed !disabled:
        image-clip: 229 35 15 8

    Button
      image-source: /images/automap/automap_rose
      image-clip: 0 28 15 15
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 28
      size: 15 15
      @onClick: |
        onClickRoseButton('south-west')

      $hover !disabled:
        image-clip: 0 28 15 15

      $pressed !disabled:
        image-clip: 258 28 15 15

    Button
      image-source: /images/automap/automap_rose
      image-clip: 0 14 8 15
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 14
      size: 8 15
      @onClick: |
        onClickRoseButton('west')

      $hover !disabled:
        image-clip: 0 14 8 15

      $pressed !disabled:
        image-clip: 301 14 8 15

    Button
      image-source: /images/automap/automap_rose
      image-clip: 0 0 15 15
      anchors.left: parent.left
      anchors.top: parent.top
      size: 15 15
      @onClick: |
        onClickRoseButton('north-west')

      $hover !disabled:
        image-clip: 0 0 15 15

      $pressed !disabled:
        image-clip: 344 0 15 15

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 118
    maximum: 260
